-
-namespace
-{
-
-using namespace Slate;
-
-constexpr std::uint32_t DisplayAlong  = 400u;    // [px]
-constexpr std::uint32_t DisplayAcross = 760u;    // [px]
-
-constexpr float DirectoryAlong  = 350.0f;   // [px] - the reference's directory column
