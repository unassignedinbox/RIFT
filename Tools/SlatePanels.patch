+                        Surface.TextRun(CardBody.LeastAlong, RowAcross, Ordinates.TextureSeated[Ordinal] ? "IMPORTED BASE" : "IMPORTED BASE \xE2\x80\x94 OPTIONAL", Sheet.InkFaint, 10.0f);
