+/// 🧩 The pickbar — a pill head opening a styled option list, for generators and transfer captions.
+/// tag   internal
+void PresentPickbar(PanelExchange& Surface, const PlaneExtent& Seat, const char* CurrentRun, const char* PushIdentity)
