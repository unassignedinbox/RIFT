+                const ControlRowDeclaration SuppressRow = { "Suppress", 88.0f, 13.5f };
+                PresentSwitchRow(Surface, Spanning(CardArea.LeastAlong, RowAcross, CardArea.SpanAlong(), 36.0f), SuppressRow,
