diff --git a/Engine/SlateUI/Interface/OutlinerPanel/Source/OutlinerPanel.cpp b/Engine/SlateUI/Interface/OutlinerPanel/Source/OutlinerPanel.cpp
new file mode 100644
index 0000000..4359bea
