+    Surface.Edge(ChipsRegion, Sheet.HairEdge, 1.0f, 12.0f);
+
+    Surface.TextRun(ChipsRegion.LeastAlong + 10.0f, ChipsRegion.LeastAcross + 9.0f, "CHANNELS", Sheet.InkFaint, 10.0f);
