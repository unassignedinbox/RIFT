+    { "", "MetalEdgeWear",    "Metal Edge Wear",   "Curvature + grunge", 3u, { "Intensity", "Softness", "Grain" },      { 0.6, 0.3, 0.45 } },
+    { "", "DirtAccumulation", "Dirt",              "Occlusion-driven",   2u, { "Amount", "Scale", "" },                { 0.5, 0.3, 0.0 } },
